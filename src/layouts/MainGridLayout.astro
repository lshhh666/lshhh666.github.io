---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	wide?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	wide = false,
} = Astro.props;

const showToc = !wide && siteConfig.toc.enable && headings.length > 0;
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
	<div class="relative z-10 w-full">
		<div class:list={[
			"mx-auto px-6 pt-12 md:pt-14 pb-8",
			wide ? "max-w-[70.5rem]" : "max-w-[74rem]",
		]}>
			<div id="main-grid" class:list={[
				"grid items-start gap-8",
				wide
					? "grid-cols-1"
					: "grid-cols-1 lg:grid-cols-[11.25rem_minmax(0,48rem)] lg:justify-center 2xl:grid-cols-[11.25rem_minmax(0,48rem)_9.5rem]",
			]}>
				{!wide && (
					<SideBar class="hidden lg:block sticky top-24 self-start onload-animation" headings={headings} />
				)}

				<main id="swup-container" tabindex="-1" class="transition-swup-fade min-w-0">
					<div id="content-wrapper" class="onload-animation">
						<slot />
						<Footer />
					</div>
				</main>

				{showToc && (
					<aside class="hidden 2xl:block sticky top-24 self-start">
						<div id="toc-inner-wrapper" class="max-h-[calc(100vh-8rem)] overflow-y-auto hide-scrollbar">
							<div id="toc"><TOC headings={headings} /></div>
						</div>
					</aside>
				)}
			</div>
			<BackToTop />
		</div>
	</div>
	{!showToc && <div id="toc" class="hidden"></div>}
</Layout>
