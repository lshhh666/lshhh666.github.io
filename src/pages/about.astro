---
import { getCollection, getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import { profileConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
const aboutPost = await getEntry("spec", "about");
if (!aboutPost) throw new Error("About page content not found");
const { Content } = await render(aboutPost);
const projects = (await getCollection("projects"))
    .filter(({ data }) => ["正在维护", "原型阶段"].includes(data.status || ""))
    .sort((a, b) => a.data.order - b.data.order);
---
<MainGridLayout title="关于" description={profileConfig.bio} wide={true}>
    <header class="about-intro">
        <p>关于</p>
        <h1>你好，我是 <span>{profileConfig.name}</span></h1>
        <div>{profileConfig.bio}</div>
    </header>
    <div class="about-body">
        <section aria-label="个人介绍" class="about-story">
            <Markdown class="about-markdown"><Content /></Markdown>
        </section>
        <aside class="about-contact" aria-labelledby="contact-title">
            <h2 id="contact-title">找到我</h2>
            <p>项目源码和更新记录在 GitHub。</p>
            {profileConfig.links.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.name}<span aria-hidden="true">↗</span></a>)}
        </aside>
    </div>
    <section class="about-projects" aria-labelledby="recent-work-title">
        <div class="section-heading"><h2 id="recent-work-title">最近在做</h2><a href={url('/projects/')}>全部作品 <span aria-hidden="true">↗</span></a></div>
        {projects.map(({ data }) => <a class="about-project" href={data.link} target="_blank" rel="noopener noreferrer">
            <div class="project-status">{data.year}<span>{data.status}</span></div>
            <div><h3>{data.title}</h3><p>{data.description}</p></div>
            <span class="project-arrow" aria-hidden="true">↗</span>
        </a>)}
    </section>
</MainGridLayout>
<style>
.about-intro { padding:22px 0 34px; border-bottom:1px solid rgba(255,255,255,.1); }
.about-intro > p { color:#d9a65f; font-size:12px; margin-bottom:17px; }
.about-intro h1 { color:#edf1f6; font-size:clamp(30px,3.2vw,44px); font-weight:500; letter-spacing:-.04em; line-height:1.35; }
.about-intro h1 span { white-space:nowrap; }
.about-intro > div { margin-top:16px; font-size:14px; color:#99a8ba; }
.about-body { display:grid; grid-template-columns:minmax(0,1fr) 240px; gap:80px; padding:34px 0 42px; }
.about-story { max-width:650px; min-width:0; }
.about-contact { border-left:1px solid rgba(255,255,255,.1); padding-left:28px; align-self:start; }
.about-contact h2, .section-heading h2 { color:#e3e9f1; font-size:18px; font-weight:500; }
.about-contact p { color:#99a8ba; font-size:13px; line-height:1.9; margin:14px 0 18px; }
.about-contact a { display:flex; justify-content:space-between; color:#dfad69; font-size:14px; padding:8px 0; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; padding-bottom:18px; }
.section-heading a { color:#a9b5c5; font-size:12px; }
.about-project { display:grid; grid-template-columns:145px minmax(0,1fr) 20px; gap:24px; border-top:1px solid rgba(255,255,255,.09); padding:25px 0; }
.project-status { color:#93a3b6; font-size:12px; padding-top:4px; }
.project-status span { display:block; color:#c5a578; margin-top:9px; }
.about-project h3 { color:#dde5ef; font-size:18px; line-height:1.6; font-weight:500; transition:color .2s; }
.about-project p { color:#94a4b7; font-size:13px; line-height:1.9; margin-top:8px; }
.project-arrow { color:#8d9eb2; padding-top:4px; }
.about-project:hover h3, .section-heading a:hover { color:#ffbf71; }
@media(max-width:767px) {
 .about-intro { padding:0 0 27px; }
 .about-body { grid-template-columns:1fr; gap:28px; padding:24px 0 38px; }
 .about-contact { border-left:0; border-top:1px solid rgba(255,255,255,.09); padding:23px 0 0; }
 .about-contact a { max-width:240px; }
 .about-project { grid-template-columns:minmax(0,1fr) 20px; gap:9px 14px; padding:22px 0; }
 .project-status { grid-column:1 / -1; display:flex; gap:14px; }
 .project-status span { margin:0; }
 .about-project h3 { font-size:17px; }
}
</style>
