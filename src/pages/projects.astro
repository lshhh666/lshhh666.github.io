---
import { getCollection } from "astro:content";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = projects;
const [featuredName, featuredSubtitle] = featured?.data.title.split(" · ") ?? [];
const featuredCover = featured?.data.cover?.startsWith('/') ? url(featured.data.cover) : featured?.data.cover;
const notes = featured ? [
    { label: "使用场景", text: featured.data.problem },
    { label: "我的工作", text: featured.data.contribution },
    { label: "当前进展", text: featured.data.progress },
].filter(note => note.text) : [];
---

<MainGridLayout title="作品" description="做过的项目，以及它们解决的问题、开发过程与当前进展。" wide={true}>
    <div class="work-page">
        <header class="work-intro">
            <p class="work-eyebrow">作品</p>
            <h1>把想法，做成能用的东西。</h1>
            <p class="work-lead">从日常遇到的问题出发，做一些工具，也把开发过程和还在探索的部分留在这里。</p>
            <div class="work-overview"><span>{projects.length} 个项目</span><span>工具 · 应用 · 个人网站</span></div>
        </header>
        {featured && (
            <section class="work-feature" aria-labelledby="featured-title">
                <div class="work-section-label"><span>重点项目</span><span class="work-status">{featured.data.status}</span></div>
                <div class:list={["work-feature-main", { "has-cover": !!featured.data.cover }]}>
                    <div class="work-copy">
                        <h2 id="featured-title">{featuredName}{featuredSubtitle && <span>{featuredSubtitle}</span>}</h2>
                        <p>{featured.data.description}</p>
                        <dl class="work-facts">
                            {featured.data.role && <div><dt>负责</dt><dd>{featured.data.role}</dd></div>}
                            {featured.data.tech && <div><dt>技术</dt><dd>{featured.data.tech}</dd></div>}
                            {featured.data.year && <div><dt>年份</dt><dd>{featured.data.year}</dd></div>}
                        </dl>
                        <a class="work-primary" href={featured.data.link} target="_blank" rel="noopener noreferrer">查看项目与开发记录 <span aria-hidden="true">↗</span></a>
                    </div>
                    {featured.data.cover && <figure class="work-figure">
                        <a href={featuredCover} target="_blank" rel="noopener noreferrer" aria-label={`查看 ${featured.data.title} 完整截图`}>
                            <img src={featuredCover} alt={featured.data.coverAlt || `${featured.data.title} 项目界面`} width={featured.data.coverWidth} height={featured.data.coverHeight} loading="eager" />
                        </a>
                        <figcaption><span>{featured.data.coverCaption || "项目界面"}</span><a href={featuredCover} target="_blank" rel="noopener noreferrer">查看大图 ↗</a></figcaption>
                    </figure>}
                </div>
                {notes.length > 0 && <dl class="work-notes">{notes.map(note => <div><dt>{note.label}</dt><dd>{note.text}</dd></div>)}</dl>}
            </section>
        )}
        {rest.length > 0 && <section class="work-others" aria-labelledby="other-work-title">
            <h2 id="other-work-title">其他作品</h2>
            {rest.map((project, index) => (
                <article class="work-row">
                    <span class="work-number" aria-hidden="true">{String(index + 2).padStart(2, "0")}</span>
                    <div class="work-row-copy">
                        <h3><a href={project.data.link} target="_blank" rel="noopener noreferrer">{project.data.title}<span aria-hidden="true">↗</span></a></h3>
                        <p>{project.data.description}</p>
                        <div class="work-row-meta">{project.data.role && <span>{project.data.role}</span>}{project.data.tech && <span>{project.data.tech}</span>}</div>
                    </div>
                    <div class="work-row-state"><span>{project.data.status}</span><time>{project.data.year}</time></div>
                </article>
            ))}
        </section>}
        {projects.length === 0 && <p class="work-empty">作品正在整理中，先去看看<a href={url('/archive/')}>开发记录 ↗</a>。</p>}
    </div>
</MainGridLayout>

<style>
    .work-page { --work-line: rgba(188,205,224,.13); color: #e9eef3; }
    a:focus-visible { outline: 2px solid #eab778; outline-offset: 5px; }
    .work-intro { padding: 22px 0 39px; border-bottom: 1px solid var(--work-line); }
    .work-eyebrow { margin: 0 0 17px; color: #eab778; font-size: 12px; letter-spacing: 3px; }
    h1 { margin: 0; font-size: clamp(30px,3.2vw,44px); font-weight: 500; line-height: 1.4; letter-spacing: -.035em; text-wrap: balance; }
    .work-lead { max-width: 580px; margin: 18px 0 0; color: #a6b3c3; font-size: 14px; line-height: 1.9; }
    .work-overview { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 25px; color: #93a3b6; font-size: 12px; }
    .work-overview span + span::before { content: '·'; margin-right: 22px; }
    .work-feature { padding: 30px 0 0; }
    .work-section-label { display: flex; justify-content: space-between; gap: 20px; color: #a6b3c3; font-size: 12px; }
    .work-status { color: #bac8b4; }
    .work-status::before { content: '●'; font-size: 8px; margin-right: 8px; }
    .work-feature-main { display: grid; gap: 42px; padding: 30px 0 34px; align-items: center; }
    .work-feature-main.has-cover { grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); }
    .work-copy h2 { margin: 0; font-size: clamp(27px,2.4vw,34px); line-height: 1.35; letter-spacing: -.025em; font-weight: 500; }
    .work-copy h2 span { display: block; margin-top: 8px; color: #adbac9; font-size: 20px; font-weight: 400; letter-spacing: 0; }
    .work-copy > p { margin: 23px 0; color: #a6b3c3; font-size: 14px; line-height: 1.95; }
    .work-facts { margin: 0 0 26px; }
    .work-facts div { display: grid; grid-template-columns: 48px 1fr; gap: 12px; padding: 8px 0; font-size: 12px; }
    .work-facts dt { color: #93a3b6; }
    .work-facts dd { margin: 0; color: #cbd4df; }
    .work-primary { display: inline-flex; gap: 27px; align-items: center; padding: 12px 17px; border: 1px solid rgba(234,183,120,.4); border-radius: 4px; color: #eab778; font-size: 12px; }
    .work-primary:hover { border-color: #eab778; background: rgba(234,183,120,.05); }
    .work-figure { min-width: 0; margin: 0; }
    .work-figure > a { display: block; padding: 16px; border: 1px solid #283342; border-radius: 8px; background: #111923; }
    .work-figure img { display: block; width: 100%; height: auto; border-radius: 3px; }
    figcaption { display: flex; justify-content: space-between; gap: 15px; margin-top: 12px; color: #99a9bc; font-size: 11px; line-height: 1.75; }
    figcaption a { flex-shrink: 0; }
    figcaption a:hover { color: #eab778; }
    .work-notes { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 30px; margin: 0; padding: 27px 0 34px; border-top: 1px solid var(--work-line); border-bottom: 1px solid var(--work-line); }
    .work-notes dt { color: #e1e7ee; font-size: 13px; }
    .work-notes dd { margin: 12px 0 0; color: #a6b3c3; font-size: 13px; line-height: 1.9; }
    .work-others { padding-top: 39px; }
    .work-others > h2 { margin: 0 0 4px; color: #a6b3c3; font-size: 13px; font-weight: 400; }
    .work-row { display: grid; grid-template-columns: 42px minmax(0,1fr) 105px; gap: 22px; padding: 29px 0; border-bottom: 1px solid var(--work-line); align-items: baseline; }
    .work-number { color: #93a3b6; font: 12px monospace; }
    .work-row h3 { margin: 0; font-size: 20px; line-height: 1.6; font-weight: 500; }
    .work-row h3 a span { margin-left: 15px; font-size: 16px; color: #a6b3c3; }
    .work-row h3 a:hover, .work-row h3 a:hover span { color: #eab778; }
    .work-row p { max-width: 700px; margin: 10px 0 13px; color: #a6b3c3; font-size: 13px; line-height: 1.9; }
    .work-row-meta { display: flex; flex-wrap: wrap; gap: 8px 18px; color: #93a3b6; font-size: 11px; }
    .work-row-state { display: flex; flex-direction: column; align-items: end; gap: 12px; color: #a6b3c3; font-size: 12px; }
    .work-row-state time { color: #93a3b6; font: 11px monospace; }
    .work-empty { padding: 45px 0; color: #a6b3c3; }
    .work-empty a { color: #eab778; }
    @media(max-width: 760px) {
        .work-intro { padding: 0 0 28px; }
        .work-feature-main.has-cover { grid-template-columns: minmax(0,1fr); }
        .work-feature-main { gap: 25px; padding-top: 25px; }
        .work-copy h2 { font-size: 29px; }
        .work-copy h2 span { font-size: 19px; }
        .work-figure > a { padding: 8px; }
        figcaption { font-size: 10px; }
        .work-notes { grid-template-columns: minmax(0,1fr); gap: 23px; padding: 26px 0; }
        .work-notes dd { margin-top: 8px; }
        .work-row { grid-template-columns: 25px minmax(0,1fr); gap: 9px 12px; padding: 25px 0; }
        .work-row h3 { font-size: 18px; }
        .work-row-state { grid-column: 2; flex-direction: row; align-items: center; gap: 18px; }
        .work-row-meta { font-size: 11px; }
    }
</style>
