---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Footer from "../components/Footer.astro";
import LighthouseHero from "../components/LighthouseHero.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import Pagination from "../components/control/Pagination.astro";
import { PAGE_SIZE } from "../constants/constants";
import { profileConfig } from "../config";
import Layout from "../layouts/Layout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";
import "../styles/home.css";

export const getStaticPaths = (async ({ paginate }) => {
    return paginate(await getSortedPosts(), { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const isFront = page.currentPage === 1;
const projects = isFront ? await getCollection("projects") : [];
const featured = projects.sort((a, b) => a.data.order - b.data.order)[0];
const fmtDate = (date: Date) => date.toISOString().slice(0, 10);
---

<Layout>
    <main class="home-page relative z-10" id="swup-container" tabindex="-1">
        {isFront && (
            <LighthouseHero>
                <div class="home-hero-copy">
                    <p class="home-eyebrow">A LIGHT ALONG THE WAY</p>
                    <h1><span class="home-title-line">把做过的东西，</span><span>和没想明白的事，</span><span class="home-title-end">记下来。</span></h1>
                    <p class="home-intro">开发记录、项目复盘，偶尔写点生活。<br />给走过的路留一盏灯，也给下一次出发留一点线索。</p>
                    <div class="home-actions">
                        <a class="home-primary" href="#writing">开始阅读 <span aria-hidden="true">↓</span></a>
                        <a class="home-secondary" href={featured ? '#work' : url('/projects/')}>看看我的作品 <span aria-hidden="true">↗</span></a>
                    </div>
                </div>
            </LighthouseHero>
        )}
        <div class="home-wrap">
            <section class="home-section" id="writing" aria-labelledby="writing-title">
                <div class="home-section-head">
                    <div><p class="home-kicker">01 / FIELD NOTES</p>{isFront ? <h2 id="writing-title">最近写下的</h2> : <h1 id="writing-title">文章 · 第 {page.currentPage} 页</h1>}</div>
                    <a class="home-link" href={url('/archive/')}>全部文章 <span aria-hidden="true">↗</span></a>
                </div>
                {page.data.map(({ slug, data }) => (
                    <a class="home-post" href={getPostUrlBySlug(slug)}>
                        <time class="home-date" datetime={fmtDate(data.published)}>{fmtDate(data.published).replaceAll('-', '.')}</time>
                        <div class="home-post-copy">
                            <h3>{data.title}</h3>
                            {data.description && <p>{data.description}</p>}
                            <div class="home-meta">{data.category && <span>{data.category}</span>}{data.tags.filter(tag => tag !== data.category).slice(0, 2).map(tag => <span>{tag}</span>)}</div>
                        </div>
                        <span class="home-arrow" aria-hidden="true">↗</span>
                    </a>
                ))}
                {page.lastPage > 1 && <Pagination class="mx-auto mt-8" page={page} />}
            </section>
            {isFront && featured && (
                <section class="home-section" id="work" aria-labelledby="work-title">
                    <div class="home-section-head">
                        <div><p class="home-kicker">02 / WORK IN PROGRESS</p><h2 id="work-title">也在动手做些东西</h2></div>
                        <a class="home-link" href={url('/projects/')}>全部作品 <span aria-hidden="true">↗</span></a>
                    </div>
                    <FeaturedProject project={featured} />
                </section>
            )}
            {isFront && <section class="home-about" aria-label="关于作者"><p><strong>你好，我是 {profileConfig.name}。</strong><br />写代码，做点小工具，把过程留在这里。</p><a class="home-link" href={url('/about/')}>更多关于我 <span aria-hidden="true">↗</span></a></section>}
            <Footer />
        </div>
    </main>
    <div id="toc" class="hidden"></div>
</Layout>
