---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";
const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
    <span>&copy; {currentYear} {profileConfig.name} · 灯塔 Lighthouse</span>
    <div class="footer-links">
        <a href={url('rss.xml')}>RSS</a>
        <a href={url('sitemap-index.xml')}>Sitemap</a>
        <span>Powered by <a target="_blank" rel="noopener noreferrer" href="https://astro.build">Astro</a> &amp; <a target="_blank" rel="noopener noreferrer" href="https://github.com/saicaca/fuwari">Fuwari</a></span>
    </div>
</footer>
<style>
.site-footer { margin-top:64px; border-top:1px solid rgba(255,255,255,.08); padding:25px 0 36px; display:flex; flex-wrap:wrap; justify-content:space-between; gap:14px 28px; color:#93a3b6; font-size:12px; line-height:1.9; }
.footer-links { display:flex; flex-wrap:wrap; gap:6px 16px; }
a { transition:color .2s; }
a:hover { color:#ffb454; }
@media(max-width:767px) { .site-footer { margin-top:44px; font-size:11px; } }
</style>
