---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<footer class="mt-[70px] border-t border-white/[0.06]">
    <div class="max-w-[67.5rem] mx-auto px-4 md:px-8 pt-[26px] pb-[52px] flex flex-col sm:flex-row sm:justify-between gap-2 text-[12.5px] text-[#4d5866]">
        <span>&copy; {currentYear} {profileConfig.name} · 灯塔 Lighthouse</span>
        <span>
            <a class="transition-colors hover:text-[#ffb454]" target="_blank" href={url('rss.xml')}>RSS</a>
            <span class="mx-1">·</span>
            <a class="transition-colors hover:text-[#ffb454]" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a>
            <span class="mx-1">·</span>
            Powered by
            <a class="transition-colors hover:text-[#ffb454]" target="_blank" href="https://astro.build">Astro</a>
            &
            <a class="transition-colors hover:text-[#ffb454]" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
        </span>
    </div>
</footer>
