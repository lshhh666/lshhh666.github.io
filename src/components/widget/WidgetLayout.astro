---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";

interface Props {
	id: string;
	name?: string;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	class?: string;
	style?: string;
}
const { id, name, isCollapsed, collapsedHeight, style } = Astro.props;
const className = Astro.props.class;
---

<widget-layout data-id={id} data-is-collapsed={String(isCollapsed)} class:list={["block border-t border-white/[0.08] pt-3", className]} style={style}>
	<div class="mb-1 text-[10.5px] font-semibold uppercase tracking-[.14em] text-[#697585]">{name}</div>
	<div id={id} class:list={["collapse-wrapper overflow-hidden", {"collapsed": isCollapsed}]}>
		<slot />
	</div>
	{isCollapsed && (
		<button class="expand-btn mt-2 text-[12px] text-[#ffb454] hover:text-[#ffd099]">
			{i18n(I18nKey.more)} →
		</button>
	)}
</widget-layout>

<style define:vars={{ collapsedHeight }}>
	.collapsed { height: var(--collapsedHeight); }
</style>

<script>
	class WidgetLayout extends HTMLElement {
		connectedCallback() {
			if (this.dataset.isCollapsed !== "true") return;
			const button = this.querySelector<HTMLButtonElement>(".expand-btn");
			const wrapper = this.querySelector<HTMLElement>(`#${this.dataset.id}`);
			button?.addEventListener("click", () => {
				wrapper?.classList.remove("collapsed");
				button.classList.add("hidden");
			});
		}
	}
	if (!customElements.get("widget-layout")) customElements.define("widget-layout", WidgetLayout);
</script>
