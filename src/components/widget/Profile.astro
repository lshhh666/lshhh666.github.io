---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---

<section class="border-t border-white/[0.08] pt-4">
	<a href={url('/about/')} aria-label="查看作者介绍" class="inline-block overflow-hidden rounded-lg border border-white/[0.08]">
		<ImageWrapper src={config.avatar || ""} alt={`${config.name} 的头像`} class="w-[72px] h-[72px] object-cover" />
	</a>
	<h2 class="mt-3 mb-0 text-[15px] font-bold text-[#e9edf2]">{config.name}</h2>
	<p class="mt-1 mb-0 text-[12.5px] leading-[1.65] text-[#8a96a5]">{config.bio}</p>
	<div class="mt-3 flex flex-col items-start gap-2">
		{config.links.map((item) => (
			<a rel="me noopener noreferrer" aria-label={item.name} href={item.url} target="_blank"
			   class="inline-flex items-center gap-2 text-[12.5px] text-[#ffb454] hover:text-[#ffd099]">
				<Icon name={item.icon} class="text-[1rem]" />{item.name} ↗
			</a>
		))}
	</div>
</section>
