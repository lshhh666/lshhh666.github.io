---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label}>
    <button
        class:list={`
            w-full
            min-h-8
            bg-none
            transition-colors
            text-[#8a96a5]
            hover:text-[var(--primary)]
        `
        }
    >
        <div class="flex items-center justify-between gap-3 py-1 text-[12.5px]">
            <div class="overflow-hidden text-left whitespace-nowrap overflow-ellipsis  ">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="text-[11.5px] tabular-nums text-[#697585]">
                    { badge }
                </div>
            }
        </div>
    </button>
</a>
