---
interface Props { quiet?: boolean; }
const { quiet = true } = Astro.props;
// Static, sparse points replace the continuous mouse-attraction canvas loop.
const points = Array.from({ length: 22 }, (_, i) => ({
    x: (i * 43.7 + 7) % 100,
    y: (i * 31.3 + 11) % 100,
    size: i % 3 === 0 ? 1.4 : 1,
}));
---
<div id="star-field" class:list={["night-grain", { quiet }]} aria-hidden="true">
    {points.map(point => <i style={`left:${point.x}%;top:${point.y}%;width:${point.size}px;height:${point.size}px;`}></i>)}
</div>
<style>
    .night-grain { position: fixed; inset: 0; pointer-events: none; opacity: .28; mask-image: linear-gradient(90deg, #000, transparent 24%, transparent 76%, #000); }
    .night-grain i { position: absolute; border-radius: 50%; background: #a7bbd0; }
    .night-grain.quiet { opacity: .14; mask-image: linear-gradient(90deg, #000, transparent 15%, transparent 85%, #000); }
    @media (max-width: 760px) { .night-grain { opacity: .12; } .night-grain.quiet { display: none; } }
</style>
