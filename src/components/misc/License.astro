---
import { licenseConfig, profileConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import { getPostUrlBySlug } from "../../utils/url-utils";

interface Props {
    title: string;
    slug: string;
    pubDate: Date;
    class?: string;
}
const { title, slug, pubDate, class: className } = Astro.props;
const postUrl = new URL(getPostUrlBySlug(slug), Astro.site || Astro.url.origin).href;
---
<aside class:list={["post-attribution", className]} aria-label={`${title} 的署名与许可`}>
    <p><span>作者</span> {profileConfig.name}<span class="attribution-divider" aria-hidden="true">·</span><time datetime={formatDateToYYYYMMDD(pubDate)}>{formatDateToYYYYMMDD(pubDate)}</time></p>
    <p>本文采用 <a href={licenseConfig.url} target="_blank" rel="noopener noreferrer">{licenseConfig.name}</a> 许可。<a class="attribution-source" href={postUrl}>原文链接 <span aria-hidden="true">↗</span></a></p>
</aside>
<style>
    .post-attribution { margin-top: 40px; padding: 18px 0; border-top: 1px solid rgba(188,205,224,.13); color: #9aa9bb; font-size: 12px; line-height: 1.9; }
    p { margin: 0; }
    p + p { margin-top: 3px; }
    .attribution-divider { margin: 0 10px; }
    a { color: #bcc8d6; text-decoration: underline; text-decoration-color: #5e6b7c; text-underline-offset: 3px; }
    a:hover { color: #eab778; }
    a:focus-visible { outline: 2px solid #eab778; outline-offset: 4px; }
    .attribution-source { display: inline-block; margin-left: 12px; }
</style>
